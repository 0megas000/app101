# PostgreSQL connection
DATABASE_URL="postgresql://preworkout:preworkout_dev@localhost:5432/preworkout"

# HTTP port for the API server
PORT=4000

# Machine identity this server instance runs as (matches Machine.serial in seed)
MACHINE_SERIAL=PWX-001

# Idle timeout (seconds) before the kiosk returns to the attract screen
KIOSK_IDLE_TIMEOUT_SECONDS=60
